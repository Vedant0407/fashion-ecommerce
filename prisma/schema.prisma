// PostgreSQL schema for GreenO. Supabase Auth owns credentials; this schema stores commerce data.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String    @id @db.Uuid
  name           String
  email          String    @unique
  provider       String    @default("email")
  email_verified Boolean   @default(false)
  role           String    @default("customer")
  phone          String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  last_login_at  DateTime?
  orders         Order[]
  addresses      Address[]
  wishlist       WishlistItem[]
  reviews       Review[]
  cart           Cart?

  @@index([email])
  @@index([role])
  @@map("profiles")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  image       String?
  description String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  products    Product[]

  @@index([slug])
  @@map("categories")
}

model Product {
  id             String      @id
  name           String
  price          Float
  description    String
  category_id    String?
  category_slug  String      @default("shirts")
  category_name  String      @default("SHIRTS")
  category       Category?   @relation(fields: [category_id], references: [id], onDelete: SetNull)
  image          String
  images         String      @default("[]")
  stock          Int         @default(50)
  size_stock     String      @default("{}")
  colors         String      @default("[]")
  color          String      @default("BLACK")
  product_no     String?
  material       String?
  fabric         String?
  fit            String?
  is_featured    Boolean     @default(false)
  is_new         Boolean     @default(false)
  is_trending    Boolean     @default(false)
  collection_tag String?
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  order_items    OrderItem[]
  reviews        Review[]
  wishlisted_by  WishlistItem[]

  @@index([category_slug])
  @@index([is_featured])
  @@index([is_new])
  @@index([is_trending])
  @@map("products")
}

model Address {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String   @db.Uuid
  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  full_name      String
  phone          String
  address_line1  String
  address_line2  String?
  city           String
  state          String
  postal_code    String
  country        String   @default("India")
  is_default     Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  orders         Order[]

  @@index([user_id])
  @@map("addresses")
}

model Order {
  id             String      @id
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  user_id        String?     @db.Uuid
  user           User?       @relation(fields: [user_id], references: [id], onDelete: SetNull)
  address_id     String?     @db.Uuid
  address_record Address?    @relation(fields: [address_id], references: [id], onDelete: SetNull)
  customer_name  String
  customer_email String
  customer_phone String
  address        String
  city           String
  state          String
  pincode        String
  subtotal       Float
  shipping       Float
  discount       Float       @default(0)
  total          Float
  status         String      @default("confirmed")
  payment_method String      @default("COD")
  payment_status String      @default("pending")
  notes          String?
  items          OrderItem[]
  returns        ReturnRequest[]

  @@index([user_id])
  @@index([customer_email])
  @@index([status])
  @@index([created_at])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id   String
  order      Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product_id String?
  product    Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)
  name       String   @map("product_name")
  price      Float    @map("product_price")
  quantity   Int
  size       String?
  color      String?
  image      String?

  @@index([order_id])
  @@index([product_id])
  @@map("order_items")
}

model Review {
  id            String   @id @default(cuid())
  product_id    String
  product       Product? @relation(fields: [product_id], references: [id], onDelete: Cascade)
  user_id       String?  @db.Uuid
  user          User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  product_name  String?
  author        String
  location      String?
  rating        Float
  date          String
  title         String
  comment       String
  verified      Boolean  @default(true)
  sizePurchased String?
  fitFeedback   String?
  helpfulCount  Int      @default(0)
  is_featured   Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([product_id])
  @@index([is_featured])
  @@index([rating])
  @@index([user_id])
  @@map("reviews")
}

model ReturnRequest {
  id              String       @id
  order_id        String
  order           Order        @relation(fields: [order_id], references: [id], onDelete: Cascade)
  created_at      DateTime     @default(now())
  type            String       @default("return")
  status          String       @default("pending")
  reason_category String
  customer_notes  String?
  admin_notes     String?
  pickup_address  String?
  resolved_at     DateTime?
  customer_name   String
  customer_email  String
  customer_phone  String
  items           ReturnItem[]

  @@index([order_id])
  @@index([status])
  @@map("return_requests")
}

model ReturnItem {
  id             String        @id @default(cuid())
  return_id      String
  return_request ReturnRequest @relation(fields: [return_id], references: [id], onDelete: Cascade)
  product_id     String
  name           String
  price          Float
  quantity       Int
  size           String?
  color          String?
  image          String?
  exchange_size  String?
  exchange_color String?
  reason         String?

  @@index([return_id])
  @@map("return_items")
}

model WishlistItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product_id String
  product    Product? @relation(fields: [product_id], references: [id], onDelete: Cascade)
  name       String
  price      Float
  image      String
  category   String?
  created_at DateTime @default(now())

  @@unique([user_id, product_id])
  @@index([user_id])
  @@map("wishlist_items")
}

model Cart {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @unique @db.Uuid
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items      Json     @default("[]")
  updated_at DateTime @updatedAt

  @@map("carts")
}

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  type        String   @default("percentage")
  value       Float
  minOrder    Float    @default(0)
  description String
  active      Boolean  @default(true)
  usage_count Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([code])
  @@map("coupons")
}

model StoreSetting {
  id               String   @id @default("default")
  announcementText String   @default("COMPLIMENTARY SHIPPING ACROSS INDIA • COD AVAILABLE • NEW DROP IS LIVE")
  storeNotice      String   @default("All orders placed today are dispatched within 24 hours.")
  supportPhone     String   @default("+91 98765 43210")
  supportEmail     String   @default("concierge@greeno.in")
  currency         String   @default("INR")
  updated_at       DateTime @updatedAt

  @@map("store_settings")
}

model Story {
  id          String   @id @default(cuid())
  title       String
  caption     String?
  image       String
  link_url    String?
  link_text   String?  @default("EXPLORE PIECE")
  duration    Int      @default(5)
  active      Boolean  @default(true)
  order_index Int      @default(0)
  views_count Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([active])
  @@index([order_index])
  @@map("stories")
}
